# ===================================================
# 1. 目标平台与设备 (100% 锁定 CR6606 源码底板)
# ===================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6606=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ===================================================
# 2. 基础 Web 管理界面与中文语言包
# ===================================================
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ===================================================
# 3. 核心网络与 PPPoE 宽带拨号
# ===================================================
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y

# ===================================================
# 4. 完整的 IPv4 / IPv6 双栈支持
# ===================================================
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# ===================================================
# 5. 商业级无线网络驱动与 WPA3 高级安全
# 说明：强制使用 openssl 完整版替换默认的阉割版 wpad-basic
# ===================================================
CONFIG_PACKAGE_kmod-mt7615e=y
CONFIG_PACKAGE_kmod-mt7615-firmware=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_luci-app-wireless-regdb=y

# ===================================================
# 6. 无线中继与桥接协议 (Relay / WDS)
# 说明：用于接收其他 Wi-Fi 信号并扩展
# ===================================================
CONFIG_PACKAGE_relayd=y
CONFIG_PACKAGE_luci-proto-relay=y

# ===================================================
# 7. UPnP 自动端口映射 (游戏主机、BT 下载、NAS 必备)
# ===================================================
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# ===================================================
# 8. 硬件 NAT 加速与网络防火墙增强
# ===================================================
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y

# ===================================================
# 9. 实用系统排错工具
# ===================================================
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_bind-host=y