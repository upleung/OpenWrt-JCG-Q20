# 目标架构与设备配置：Amlogic -> meson8b -> Thunder OneCloud
CONFIG_TARGET_amlogic=y
CONFIG_TARGET_amlogic_meson8b=y
CONFIG_TARGET_amlogic_meson8b_DEVICE_thunder-onecloud=y

CONFIG_HAS_SUBTARGETS=y
CONFIG_HAS_DEVICES=y
CONFIG_TARGET_BOARD="amlogic"
CONFIG_TARGET_SUBTARGET="meson8b"
CONFIG_TARGET_PROFILE="DEVICE_thunder-onecloud"
CONFIG_TARGET_ARCH_PACKAGES="arm_cortex-a5_neon-vfpv4"

# 镜像生成选项：必须包含 rootfs.tar.gz（用于 Docker 打包）及 ext4 镜像
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_EXT4_RESERVED_PCT=0
CONFIG_TARGET_EXT4_BLOCKSIZE_4K=y
CONFIG_TARGET_EXT4_BLOCKSIZE=4096
CONFIG_TARGET_EXT4_JOURNAL=y
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y
CONFIG_TARGET_IMAGES_GZIP=y

# Web 管理界面 LuCI 及中文语言包
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

# 常用基础工具与网络组件
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_ip-full=y
